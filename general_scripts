# ------------- DBT ------------------------
# Generate private key (unencrypted PKCS8)
openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt -inform PEM -out /Users/alikhanzadi/.snowflake/rsa_key.p8

# Generate public key
openssl rsa -in /Users/alikhanzadi/.snowflake/rsa_key.p8 -pubout -out /Users/alikhanzadi/.snowflake/rsa_key.pub

# Place the two files (.p8 and .pub) here
/Users/alikhanzadi/.snowflake/rsa_key.pub

# Remove the headers from the .pub file, also line breaks - it should be all lines, it should be a base64 string
-----BEGIN PUBLIC KEY-----
-----END PUBLIC KEY-----

